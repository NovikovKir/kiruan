@model backend.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<h1>Вход</h1>

<form asp-action="Login" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Электронная почта</label>
        <input asp-for="Email" class="form-control" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Пароль</label>
        <input asp-for="Password" class="form-control" required />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Запомнить меня</label>
    </div>
    <button class="btn btn-primary" type="submit">Войти</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
